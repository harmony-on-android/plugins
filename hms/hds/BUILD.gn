import("//build/config/components/ets_frontend/es2abc_config.gni")
import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")
import("//foundation/arkui/ace_engine/build/ace_gen_obj.gni")

# Phase 1: compile JS mock source to ABC (host toolchain)
_hds_mock_js = "$ace_root/../../../plugins/hms/hds/src/hds_component_mock.js"

es2abc_gen_abc("gen_hds_abc") {
  src_js = rebase_path("$_hds_mock_js")
  dst_file = rebase_path(target_out_dir + "/hds_mock.abc")
  in_puts = [ "$_hds_mock_js" ]
  out_puts = [ target_out_dir + "/hds_mock.abc" ]
  extra_args = [ "--module" ]
}

# Phase 2: embed ABC into native object (target toolchain)
if (target_os == "ios") {
  gen_obj("hds_abc") {
    input =
        get_label_info(":gen_hds_abc", "target_out_dir") + "/hds_mock.abc"
    output = target_out_dir + "/hds_abc.c"
    snapshot_dep = [ ":gen_hds_abc" ]
  }
} else if (target_os == "android") {
  gen_js_obj("hds_abc") {
    input =
        get_label_info(":gen_hds_abc", "target_out_dir") + "/hds_mock.abc"
    output = target_out_dir + "/hds_abc.o"
    dep = ":gen_hds_abc"
  }
}

# Phase 3: link C++ stub + embedded ABC into shared library
template("plugin_hms_hds_static") {
  forward_variables_from(invoker, "*")

  ohos_source_set(target_name) {
    defines += invoker.defines
    cflags_cc += invoker.cflags_cc

    sources = [ "hds_base_component_stub.cpp" ]

    deps = [
      "//plugins/interfaces/native:ace_plugin_util_${platform}",
      "//plugins/libs/napi:napi_${target_os}",
    ]

    if (target_os == "ios") {
      deps += [ ":gen_obj_src_hds_abc" ]
    } else if (target_os == "android") {
      deps += [ ":hds_abc" ]
    }

    subsystem_name = "plugins"
    part_name = "hms"
  }
}

foreach(item, ace_platforms) {
  plugin_hms_hds_static("hms_hds_static_" + item.name) {
    platform = item.name

    defines = []
    cflags_cc = []
    config = {
    }

    if (defined(item.config)) {
      config = item.config
    }

    if (defined(config.defines)) {
      defines = config.defines
    }

    if (defined(config.cflags_cc)) {
      cflags_cc = config.cflags_cc
    }
  }
}
