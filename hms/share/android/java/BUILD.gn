import("//build/ohos.gni")

java_library("hms_share_android_java") {
  java_files = [
    "src/app/hackeris/hoa/plugin/share/ShareHelper.java",
  ]
  classpath_deps = [
    "//foundation/arkui/ace_engine/adapter/android/build:ace_android_adapter_java"
